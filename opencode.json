{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "routers9": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Routers9",
      "options": {
        "baseURL": "https://routers9.web.id/v1",
        "apiKey": "{env:ROUTERS9_API_KEY}"
      },
      "models": {
        "routers9/deepseek/deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash 0731",
          "limit": {
            "context": 1048576,
            "output": 384000
          }
        },
        "routers9/poolside/laguna-s-2.1": {
          "name": "Poolside Laguna S 2.1",
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "routers9/poolside/laguna-xs-2.1": {
          "name": "Poolside Laguna XS 2.1",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "routers9/upstage/solar-pro4": {
          "name": "Solar Pro 4",
          "limit": {
            "context": 524288,
            "output": 131072
          }
        },
        "routers9/longcat-2.0": {
          "name": "LongCat 2.0",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        }
      }
    }
  },
  "mcp": {
    "prisma": {
      "type": "remote",
      "url": "https://mcp.prisma.io/mcp",
      "enabled": true
    },
    "prisma-local": {
      "type": "local",
      "command": ["bash", "-c", "cd apps/server && bunx prisma mcp"],
      "enabled": true
    },
    "heroui-react": {
      "type": "local",
      "command": ["bunx", "--bun", "@heroui/react-mcp@latest"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "threejs-devtools": {
      "type": "local",
      "command": ["bunx", "--bun", "threejs-devtools-mcp@latest"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "git add": "deny",
      "git add *": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git merge*": "deny",
      "gh pr create*": "deny",
      "gh pr merge*": "deny"
    }
  },
  "agent": {
    "full-stack-engineer": {
      "permission": {
        "bash": {
          "git add": "ask",
          "git add *": "ask",
          "git commit*": "ask",
          "git push*": "ask",
          "git merge*": "ask",
          "git branch*": "ask",
          "git checkout*": "ask",
          "git clone*": "ask",
          "gh pr create*": "ask",
          "gh pr merge*": "ask",
          "gh run*": "ask",
          "gh workflow*": "ask"
        }
      }
    }
  }
}
