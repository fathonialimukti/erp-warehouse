# Base URL of the API server (tRPC + SSE + uploads) for production builds.
# The dev server uses its same-origin Vite proxy, so this is ignored in dev.
VITE_TRPC_URL=https://erp-warehouse-api.aetherglo.com

# "true" builds only the public marketing site — no login/protected routes.
# Set by `bun run build:marketing`; leave unset for the full app.
VITE_MARKETING_ONLY=
