// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/marcosgomesneto/bun-devcontainers/tree/main/src/basic-bun
{
  "name": "erp_warehouse",
  "dockerFile": "Dockerfile",
  // Forward dev server ports from container → VPS → your local machine.
  // After rebuild, access at http://localhost:10011 (frontend) and http://localhost:10012 (API).
  "runArgs": ["--network=dev", "--name=erp_warehouse"],
  "forwardPorts": [10011, 10012],
  "appPort": ["10011:10011", "10012:10012"],
  "containerEnv": {
    "HOST": "0.0.0.0",
    "NODE_ENV": "production",
    "VITE_TRPC_URL": "https://erp-warehouse-api.aetherglo.com",
    "COPILOT_PROVIDER_BASE_URL": "https://inference.poolside.ai/v1/chat/completions",
    "COPILOT_PROVIDER_API_KEY": "sky_UXu9nseA.vrrzsPz3YTTenRiNYeWXf4sGCozzSaLy",
    "COPILOT_MODEL": "poolside/laguna-s-2.1",
    "COPILOT_PROVIDER_MAX_PROMPT_TOKENS": "256000",
    "COPILOT_PROVIDER_MAX_OUTPUT_TOKENS": "32768"
  },
  "portsAttributes": {
    "10011": {
      "label": "Vite Client",
      "onAutoForward": "notify"
    },
    "10012": {
      "label": "tRPC Server",
      "onAutoForward": "notify"
    }
  },
  // Configure tool-specific properties.
  "customizations": {
    // Configure properties specific to VS Code.
    "vscode": {
      // Add the IDs of extensions you want installed when the container is created.
      "extensions": [
        "oven.bun-vscode",
        "Prisma.prisma",
        "bradlc.vscode-tailwindcorConfig",
        "dbaeumer.vscode-eslint",
        "sst-dev.opencode"
      ]
    }
  }
}