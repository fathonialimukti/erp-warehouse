# ─── ERP Warehouse — Environment (single source of truth) ───────────────────
# Copy to .env at the repo root and apps/server/.env, then fill in values.
# Never commit .env.

# ─── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://user:password@localhost:4321/erp_warehouse?schema=public"

# JWT signing secret — MUST be changed in production
JWT_SECRET="your-secret-key-change-this"

# Allowed CORS origin(s) in production (comma-separated).
CORS_ORIGIN="https://yourdomain.com"

# ─── Optional ─────────────────────────────────────────────────────────────────

# HTTP port for the Express server (default: 10012)
PORT=10012

# Client dev server port (default: 10011)
CLIENT_PORT=10011

# PostgreSQL connection pool settings
DB_POOL_MAX=10
DB_POOL_IDLE_MS=10000
DB_POOL_CONNECT_TIMEOUT_MS=2000

# Set to "production" to enable strict CORS and secure cookie flag
# NODE_ENV="production"

# Enable passwordless demo login
# DEMO_LOGIN_ENABLED="true"

# AI assistant (optional). Leave AI_API_KEY empty to disable AI features entirely.
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=

# Public web app origin (used in password reset email links)
APP_URL=http://localhost:10011

# SMTP (optional — required for email notifications)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=noreply@yourdomain.com

# Logging
# LOG_LEVEL=info

# Seed control (dev only)
# SEED_MONTHS=3
# SEED_SKIP_RESET=false

# ─── opencode (agent runtime) ─────────────────────────────────────────────────
# ROUTERS9_API_KEY=your-key-here
# OPENCODE_SERVER_USERNAME=admin
# OPENCODE_SERVER_PASSWORD=change-me
