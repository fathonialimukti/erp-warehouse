{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "prisma": {
      "type": "remote",
      "url": "https://mcp.prisma.io/mcp",
      "enabled": true
    },
    "prisma-local": {
      "type": "local",
      "command": ["bash", "-c", "cd apps/server && bunx prisma mcp"],
      "enabled": true
    },
    "heroui-react": {
      "type": "local",
      "command": ["bunx", "--bun", "@heroui/react-mcp@latest"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "threejs-devtools": {
      "type": "local",
      "command": ["bunx", "--bun", "threejs-devtools-mcp@latest"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "git add": "deny",
      "git add *": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git merge*": "deny",
      "gh pr create*": "deny",
      "gh pr merge*": "deny"
    }
  }
}
