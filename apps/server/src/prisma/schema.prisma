  details            String?          @map("details")

  @@index([returnToSupplierId])
  @@index([skuId])
  @@map("return_to_supplier_items")
}

// DS — Disposal (Oracle: Misc Issue — scrap / write-off)
model Disposal {
  id              String         @id @default(ulid()) @map("id")
  documentNumber  String?        @unique @map("document_number")
  date            DateTime       @default(now()) @map("date") @db.Date
  disposalReason  String?        @map("disposal_reason")
  reference       String?        @map("reference")
  notes           String?        @map("notes")
  warehouseId     String         @map("warehouse_id")
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdById     String         @map("created_by_id")
  createdBy       User           @relation("disposal_created_by", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  approvedById    String?        @map("approved_by_id")
  approvedBy      User?          @relation("disposal_approved_by", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedAt      DateTime?      @map("approved_at")
  approvalHistory Json?          @map("approval_history")
  approvalStatus  ApprovalStatus @default(DRAFT) @map("approval_status")
  dispatchStatus  DispatchStatus @default(PENDING) @map("dispatch_status")

  items DisposalItem[] @relation("disposal_items")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdById])
  @@index([approvedById])
  @@index([approvalStatus])
  @@index([documentNumber])
  @@index([date])
  @@index([warehouseId])
  @@index([approvalStatus, date])
  @@map("disposals")
}

model DisposalItem {
  id         String   @id @default(ulid()) @map("id")
  disposalId String   @map("disposal_id")
  disposal   Disposal @relation("disposal_items", fields: [disposalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  skuId      String   @map("sku_id")
  sku        Sku      @relation(fields: [skuId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  quantity   Decimal  @map("quantity")
  details    String?  @map("details")

  @@index([disposalId])
  @@index([skuId])
  @@map("disposal_items")
}

