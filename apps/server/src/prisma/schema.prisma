  subinventoryTransferId String               @map("subinventory_transfer_id")
  subinventoryTransfer   SubinventoryTransfer @relation("subinventory_transfer_items", fields: [subinventoryTransferId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  palletId               String               @unique @map("pallet_id")
  pallet                 Pallet               @relation("pallet_to_subinventory_transfer", fields: [palletId], references: [id])
  fromLocationId         String               @map("from_location_id")
  fromLocation           StorageLocation      @relation("subinventory_transfer_from", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocationId           String               @map("to_location_id")
