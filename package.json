{
  "name": "erp-warehouse",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "prod:init": "cd apps/server && bun prisma generate && cd ../.. && bun run build",
    "prod": "bun run build && pm2 start ecosystem.config.cjs",
    "prod:start": "cd apps/server && bun dist/index.js & cd apps/client && bun vite preview --host 0.0.0.0 --port 10011 & wait",
    "prod:restart": "pm2 restart ecosystem.config.cjs",
    "prod:logs": "pm2 logs",
    "prod:stop": "pm2 stop ecosystem.config.cjs",
    "restart-prod": "pm2 restart ecosystem.config.cjs",
    "stop-prod": "pm2 stop ecosystem.config.cjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^20.0.0",
    "@trpc/server": "^11.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.9.4",
    "turbo": "^2.10.8",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "*.{ts,tsx,md}": [
      "prettier --write"
    ]
  }
}
