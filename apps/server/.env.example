# ─── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://user:password@localhost:5432/erp_warehouse?schema=public"

# JWT signing secret — MUST be changed in production
JWT_SECRET="your-secret-key-change-this"

# ─── Optional (defaults shown) ───────────────────────────────────────────────

# HTTP port for the Express server
PORT=10012

# Allowed CORS origin(s) in production (comma-separated).
# Default: the client app at erp-warehouse.aetherglo.com.
# In development, all localhost:* ports and tauri://localhost are allowed automatically.
CORS_ORIGIN="https://erp-warehouse.aetherglo.com"

# The API server's own URL — set when deployed on a separate subdomain.
# Not read by the server itself, but documented here for the client's VITE_TRPC_URL.
# API_URL="https://erp-warehouse-api.aetherglo.com"

# PostgreSQL connection pool settings
DB_POOL_MAX=10
DB_POOL_IDLE_MS=10000
DB_POOL_CONNECT_TIMEOUT_MS=2000

# Set to "production" to enable strict CORS and secure cookie flag
# NODE_ENV="production"

# AI assistant (optional). Leave AI_API_KEY empty to disable AI features entirely.
# The server falls back to an empty key (no-op) when unset, so the app runs fine
# without these — only the chat assistant is unavailable.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=