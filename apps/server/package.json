{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json && cp -r src/prisma/generated dist/prisma/generated",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "bun src/scripts/guard-seed.ts && bun prisma generate && bun prisma migrate reset --force && bun prisma db seed",
    "db:all": "bun prisma generate && bun prisma migrate reset --force && bun prisma db seed && bun src/scripts/backfill-pallet-numbers.ts",
    "db:backfill-pallet-numbers": "bun src/scripts/backfill-pallet-numbers.ts",
    "db:ensure-permissions": "bun src/scripts/ensure-permissions.ts",
    "ai:ingest": "bun src/scripts/ingest-knowledge.ts",
    "ai:embed": "bun src/scripts/embed-knowledge.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.79",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "^7.10.0",
    "@repo/schemas": "*",
    "@trpc/server": "^11.17.0",
    "@types/nodemailer": "^8.0.1",
    "ai": "^7.0.128",
    "bcrypt": "^6.0.0",
    "cookie": "^1.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.0",
    "pino": "^9.6.0",
    "xss": "^1.0.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "pg": "^8.21.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^7.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
