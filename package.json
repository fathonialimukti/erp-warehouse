{
  "name": "erp-warehouse",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "tsc": "cd apps/server && tsc --noEmit && cd ../client && tsc --noEmit && cd ../../packages/schemas && tsc --noEmit"
  },
  "devDependencies": {
    "@trpc/server": "^11.18.0",
    "prettier": "^3.9.4",
    "turbo": "^2.10.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
