// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/marcosgomesneto/bun-devcontainers/tree/main/src/basic-bun
{
  "name": "erp_warehouse",
  "dockerFile": "Dockerfile",
  // Forward dev server ports from container → VPS → your local machine.
  // After rebuild, access at http://localhost:10011 (frontend) and http://localhost:10012 (API).
  "runArgs": [
    "--network=dev",
    "--name=erp_warehouse"
  ],
  "forwardPorts": [
    10011,
    10012,
    10013
  ],
  "containerEnv": {
    "HOST": "0.0.0.0",
    "NODE_ENV": "development",
    "VITE_TRPC_URL": "https://erp-warehouse-api.aetherglo.com"
    // Secrets (e.g. ROUTERS9_API_KEY) must be injected via your environment —
    // never commit them to the repository.
  },
  "portsAttributes": {
    "10011": {
      "label": "Vite Client",
      "onAutoForward": "notify"
    },
    "10012": {
      "label": "tRPC Server",
      "onAutoForward": "notify"
    },
    "10013": {
      "label": "OpenCode Web UI",
      "onAutoForward": "openBrowser"
    }
  },
  // Configure tool-specific properties.
  "customizations": {
    // Configure properties specific to VS Code.
    "vscode": {
      // Add the IDs of extensions you want installed when the container is created.
      "extensions": [
        "oven.bun-vscode",
        "Prisma.prisma",
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint",
        "sst-dev.opencode"
      ]
    }
  },
  // Install deps + generate Prisma client after the workspace is mounted.
  // The Dockerfile can't do this at build time because package.json isn't present until runtime.
  "postCreateCommand": "bun install && cd apps/server && bun prisma generate && cd ../.. && pm2 start ecosystem.config.cjs"
}