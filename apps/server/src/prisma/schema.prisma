  originalReceivingId String?               @map("original_receiving_id")
  originalReceiving   ReceivingTransaction? @relation("return_to_supplier_original_receiving", fields: [originalReceivingId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  returnReason        String?               @map("return_reason")
  reference           String?               @map("reference")
  notes               String?               @map("notes")
  warehouseId         String                @map("warehouse_id")
  warehouse           Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdById         String                @map("created_by_id")
  createdBy           User                  @relation("return_to_supplier_created_by", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  approvedById        String?               @map("approved_by_id")
  approvedBy          User?                 @relation("return_to_supplier_approved_by", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedAt          DateTime?             @map("approved_at")
  approvalHistory     Json?                 @map("approval_history")
  approvalStatus      ApprovalStatus        @default(DRAFT) @map("approval_status")
  dispatchStatus      DispatchStatus        @default(PENDING) @map("dispatch_status")

  items ReturnToSupplierItem[] @relation("return_to_supplier_items")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([supplierId])
  @@index([originalReceivingId])
  @@index([createdById])
  @@index([approvedById])
  @@index([approvalStatus])
  @@index([documentNumber])
  @@index([date])
  @@index([warehouseId])
  @@index([approvalStatus, date])
  @@map("return_to_suppliers")
}

model ReturnToSupplierItem {
  id                 String           @id @default(ulid()) @map("id")
  returnToSupplierId String           @map("return_to_supplier_id")
  returnToSupplier   ReturnToSupplier @relation("return_to_supplier_items", fields: [returnToSupplierId], references: [id], onDelete: Cascade, onUpdate: Cascade)
