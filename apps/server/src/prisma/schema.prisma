}

// =============================================
// TRANSACTIONS — LOSS & FOUND
// =============================================

// LO — Loss Transaction (direction OUT — unexplained stock shrinkage)
model LossTransaction {
  id              String         @id @default(ulid()) @map("id")
  documentNumber  String?        @unique @map("document_number")
  date            DateTime       @default(now()) @map("date") @db.Date
  lossReason      String?        @map("loss_reason")
  reference       String?        @map("reference")
  notes           String?        @map("notes")
  warehouseId     String         @map("warehouse_id")
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdById     String         @map("created_by_id")
  createdBy       User           @relation("loss_transaction_created_by", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  approvedById    String?        @map("approved_by_id")
  approvedBy      User?          @relation("loss_transaction_approved_by", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedAt      DateTime?      @map("approved_at")
  approvalHistory Json?          @map("approval_history")
  approvalStatus  ApprovalStatus @default(DRAFT) @map("approval_status")

  items LossTransactionItem[] @relation("loss_transaction_items")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdById])
  @@index([approvedById])
  @@index([approvalStatus])
  @@index([documentNumber])
  @@index([date])
  @@index([warehouseId])
  @@index([approvalStatus, date])
  @@map("loss_transactions")
}

model LossTransactionItem {
  id                String          @id @default(ulid()) @map("id")
  lossTransactionId String          @map("loss_transaction_id")
  lossTransaction   LossTransaction @relation("loss_transaction_items", fields: [lossTransactionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  skuId             String          @map("sku_id")
  sku               Sku             @relation(fields: [skuId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  quantity          Decimal         @map("quantity")
  details           String?         @map("details")

  @@index([lossTransactionId])
  @@index([skuId])
  @@map("loss_transaction_items")
}

// FO — Found Transaction (direction IN — unexplained stock discovery)
model FoundTransaction {
  id              String         @id @default(ulid()) @map("id")
  documentNumber  String?        @unique @map("document_number")
  date            DateTime       @default(now()) @map("date") @db.Date
  foundReason     String?        @map("found_reason")
  foundLocation   String?        @map("found_location")
  reference       String?        @map("reference")
  notes           String?        @map("notes")
  warehouseId     String         @map("warehouse_id")
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdById     String         @map("created_by_id")
  createdBy       User           @relation("found_transaction_created_by", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  approvedById    String?        @map("approved_by_id")
  approvedBy      User?          @relation("found_transaction_approved_by", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedAt      DateTime?      @map("approved_at")
  approvalHistory Json?          @map("approval_history")
  approvalStatus  ApprovalStatus @default(DRAFT) @map("approval_status")
  putawayStatus   PutawayStatus  @default(PENDING) @map("putaway_status")

  items FoundTransactionItem[] @relation("found_transaction_items")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdById])
  @@index([approvedById])
  @@index([approvalStatus])
  @@index([documentNumber])
  @@index([date])
  @@index([warehouseId])
  @@index([approvalStatus, date])
  @@map("found_transactions")
}

model FoundTransactionItem {
  id                 String           @id @default(ulid()) @map("id")
  foundTransactionId String           @map("found_transaction_id")
  foundTransaction   FoundTransaction @relation("found_transaction_items", fields: [foundTransactionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  skuId              String           @map("sku_id")
  sku                Sku              @relation(fields: [skuId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  quantity           Decimal          @map("quantity")
  details            String?          @map("details")

  @@index([foundTransactionId])
  @@index([skuId])
  @@map("found_transaction_items")
}

// =============================================
// PUTAWAY & PICK LINES (Shared Warehouse Execution)
// =============================================

// PutawayLine — one row per pallet per IN transaction, created on APPROVED
// Covers: RECEIVING, WIP_COMPLETION, RMA_RECEIPT, FOUND
model PutawayLine {
  id                String                   @id @default(ulid()) @map("id")
  transactionType   WarehouseTransactionType @map("transaction_type")
  documentId        String                   @map("document_id")
  palletId          String                   @unique @map("pallet_id")
  pallet            Pallet                   @relation("pallet_putaway", fields: [palletId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  storageLocationId String?                  @map("storage_location_id")
  storageLocation   StorageLocation?         @relation("putaway_to_location", fields: [storageLocationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  status            PutawayLineStatus        @default(PENDING) @map("status")
  completedAt       DateTime?                @map("completed_at")
  completedById     String?                  @map("completed_by_id")
  completedBy       User?                    @relation("putaway_completed_by", fields: [completedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([documentId])
  @@index([transactionType, status])
  @@index([storageLocationId])
  @@map("putaway_lines")
}

// PickLine — one row per pallet per OUT transaction, created on APPROVED
// Covers: WIP_ISSUE, SHIPMENT, RETURN_TO_SUPPLIER, DISPOSAL
model PickLine {
  id              String                   @id @default(ulid()) @map("id")
  transactionType WarehouseTransactionType @map("transaction_type")
  documentId      String                   @map("document_id")
  palletId        String                   @unique @map("pallet_id")
  pallet          Pallet                   @relation("pallet_pick", fields: [palletId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fromLocationId  String?                  @map("from_location_id")
  fromLocation    StorageLocation?         @relation("pick_from_location", fields: [fromLocationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  status          PickLineStatus           @default(PENDING) @map("status")
  assignedAt      DateTime?                @map("assigned_at")
  assignedById    String?                  @map("assigned_by_id")
  assignedBy      User?                    @relation("pick_assigned_by", fields: [assignedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  completedAt     DateTime?                @map("completed_at")
  completedById   String?                  @map("completed_by_id")
  completedBy     User?                    @relation("pick_completed_by", fields: [completedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([documentId])
  @@index([transactionType, status])
  @@index([fromLocationId])
  @@map("pick_lines")
}

// =============================================
// NOTIFICATION & ACTIVITY LOG
// =============================================

model Notification {
  id          String                 @id @default(ulid()) @map("id")
  userId      String                 @map("user_id")
  user        User                   @relation("notification_recipient", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdById String?                @map("created_by_id")
  createdBy   User?                  @relation("notification_created_by", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  title       String                 @map("title")
  message     String                 @map("message")
  type        NotificationType       @default(INFO) @map("type")
  targetType  NotificationTargetType @default(SYSTEM) @map("target_type")
  targetId    String?                @map("target_id")
  actionUrl   String?                @map("action_url")
  metadata    Json?                  @map("metadata")
  isRead      Boolean                @default(false) @map("is_read")
  readAt      DateTime?              @map("read_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  @@index([userId, isRead])
  @@index([targetType, targetId])
  @@index([createdById])
  @@map("notifications")
}

model ActivityLog {
  id         String         @id @default(ulid()) @map("id")
  action     ActivityAction @map("action")
  userId     String         @map("user_id")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resource   String         @map("resource")
  resourceId String         @map("resource_id")
  message    String         @map("message")
  detail     Json?          @map("detail")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([resource, resourceId, action])
  @@index([action, createdAt])
  @@map("activity_logs")
}

model KnowledgeChunk {
  id        String   @id @default(ulid()) @map("id")
  source    String   @map("source")
  title     String   @map("title")
  content   String   @map("content")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([source])
  @@map("knowledge_chunks")
}
