{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json && cp -r src/prisma/generated dist/prisma/generated",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "bun prisma generate && bun prisma db push --force-reset && bun prisma db seed && bun src/scripts/ingest-knowledge.ts",
    "db:all": "bun prisma generate && bun prisma db push --force-reset && bun prisma db seed && bun src/scripts/backfill-pallet-numbers.ts && bun src/scripts/ingest-knowledge.ts",
    "db:backfill-pallet-numbers": "bun src/scripts/backfill-pallet-numbers.ts",
    "ai:ingest": "bun src/scripts/ingest-knowledge.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.67",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@faker-js/faker": "^9.9.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "@repo/schemas": "*",
    "@trpc/server": "^11.17.0",
    "ai": "^6.0.193",
    "bcrypt": "^6.0.0",
    "cookie": "^1.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@vitest/ui": "^4.1.8",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
